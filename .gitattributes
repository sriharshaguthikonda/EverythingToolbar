# Normalize line endings: the repo stores text files with LF; Windows tooling
# (CSharpier, VS) tends to rewrite them as CRLF, which pollutes diffs.
*.cs text eol=lf
*.xaml text eol=lf
*.csproj text eol=lf
*.vcxproj text eol=lf
*.props text eol=lf
*.targets text eol=lf
*.sln text eol=lf
*.json text eol=lf
*.resx text eol=lf
*.md text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.config text eol=lf
*.manifest text eol=lf
