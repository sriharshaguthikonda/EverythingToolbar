<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <RootNamespace>EverythingToolbar.FuzzySearch.Tests</RootNamespace>
    <SignAssembly>false</SignAssembly>
    <IsPackable>false</IsPackable>
    <!-- IDE0005 false-positives on env-gated benchmark/integration files (usings that ARE used
         only inside FUZZY_BENCH/LIVE_EVERYTHING paths); CI msbuild promotes IDE0005 to error. -->
    <NoWarn>$(NoWarn);IDE0005</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="Config.Net" />
    <PackageReference Include="xunit.runner.visualstudio">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <!-- Native SDK DLLs for the live Everything integration test (built by MSBuild.exe). -->
    <None
      Include="..\EverythingSDK3\x64\$(Configuration)\Everything3.dll"
      Condition="Exists('..\EverythingSDK3\x64\$(Configuration)\Everything3.dll')"
      CopyToOutputDirectory="PreserveNewest"
    />
    <None
      Include="..\EverythingSDK\x64\$(Configuration)\Everything64.dll"
      Condition="Exists('..\EverythingSDK\x64\$(Configuration)\Everything64.dll')"
      CopyToOutputDirectory="PreserveNewest"
    />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\EverythingToolbar.FuzzySearch\EverythingToolbar.FuzzySearch.csproj" />
    <ProjectReference Include="..\EverythingToolbar.App\EverythingToolbar.App.csproj" />
    <ProjectReference Include="..\EverythingToolbar\EverythingToolbar.csproj" />
  </ItemGroup>
</Project>
