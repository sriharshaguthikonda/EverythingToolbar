<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <RootNamespace>EverythingToolbar.App</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Config.Net" />
    <PackageReference Include="NLog" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\EverythingToolbar.Core\EverythingToolbar.Core.csproj" />
    <ProjectReference Include="..\EverythingToolbar.FuzzySearch\EverythingToolbar.FuzzySearch.csproj" />
    <ProjectReference Include="..\EverythingToolbar.Platform\EverythingToolbar.Platform.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="EverythingToolbar.App.Services" />
    <Using Include="EverythingToolbar.Core.Services" />
  </ItemGroup>
  <ItemGroup>
    <!-- Lets the test project use the internal SearchHistory test seams (injectable history
         path, Import, GetHistorySnapshot); builds that sign this assembly must also pass
         SignAssembly=false for the friend to resolve (the standard local/CI build does). -->
    <InternalsVisibleTo Include="EverythingToolbar.FuzzySearch.Tests" />
    <InternalsVisibleTo Include="EverythingToolbar" />
  </ItemGroup>
</Project>
