<Window
  x:Class="EverythingToolbar.App.ExportDialog"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:b="clr-namespace:EverythingToolbar.Behaviors"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  Title="Export Search Results"
  Width="440"
  d:DesignHeight="420"
  d:DesignWidth="440"
  Background="{DynamicResource ApplicationBackgroundBrush}"
  Foreground="{DynamicResource SearchResultFileName}"
  ResizeMode="NoResize"
  ShowInTaskbar="False"
  SizeToContent="Height"
  UseLayoutRounding="True"
  WindowStartupLocation="CenterOwner"
  mc:Ignorable="d">
  <i:Interaction.Behaviors>
    <b:Themed Surface="AppWindow" />
  </i:Interaction.Behaviors>

  <StackPanel Margin="16">
    <TextBlock
      Margin="0 0 0 4"
      Foreground="{DynamicResource SearchResultFileName}"
      Text="Format:" />
    <StackPanel Margin="0 0 0 8" Orientation="Horizontal">
      <RadioButton
        x:Name="CsvRadio"
        Margin="0 0 16 0"
        VerticalContentAlignment="Center"
        Checked="OnFormatChanged"
        Content="CSV"
        GroupName="ExportFormat"
        IsChecked="True" />
      <RadioButton
        x:Name="TxtRadio"
        Margin="0 0 16 0"
        VerticalContentAlignment="Center"
        Checked="OnFormatChanged"
        Content="TXT"
        GroupName="ExportFormat" />
      <RadioButton
        x:Name="EfuRadio"
        VerticalContentAlignment="Center"
        Checked="OnFormatChanged"
        Content="EFU"
        GroupName="ExportFormat" />
    </StackPanel>

    <StackPanel x:Name="ColumnsSection">
      <TextBlock
        Margin="0 0 0 4"
        Foreground="{DynamicResource SearchResultFileName}"
        Text="Columns:" />
      <Border
        Padding="4"
        BorderBrush="{DynamicResource TabBarBottomBorder}"
        BorderThickness="1"
        CornerRadius="2">
        <ScrollViewer MaxHeight="160" VerticalScrollBarVisibility="Auto">
          <!--
            Checked list: order is the fixed display order of ResultExporter.AvailableColumns;
            the checked set is the choice (drag reordering is not offered).
          -->
          <StackPanel x:Name="ColumnsPanel" />
        </ScrollViewer>
      </Border>
    </StackPanel>

    <TextBlock
      x:Name="ResultCountText"
      Margin="0 8 0 0"
      Foreground="{DynamicResource SearchResultPath}" />

    <StackPanel
      Margin="0 16 0 0"
      HorizontalAlignment="Right"
      Orientation="Horizontal">
      <Button
        x:Name="ExportButton"
        Width="80"
        Height="26"
        Click="OnExportClick"
        Content="Export"
        IsDefault="True" />
      <Button
        Width="80"
        Height="26"
        Margin="8 0 0 0"
        Content="Cancel"
        IsCancel="True" />
    </StackPanel>
  </StackPanel>
</Window>
