<Window
  x:Class="EverythingToolbar.App.AdvancedSearchDialog"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:b="clr-namespace:EverythingToolbar.Behaviors"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  Title="Advanced Search"
  Width="480"
  d:DesignHeight="420"
  d:DesignWidth="480"
  Background="{DynamicResource ApplicationBackgroundBrush}"
  Foreground="{DynamicResource SearchResultFileName}"
  ResizeMode="NoResize"
  ShowInTaskbar="False"
  SizeToContent="Height"
  UseLayoutRounding="True"
  WindowStartupLocation="CenterOwner"
  mc:Ignorable="d">
  <i:Interaction.Behaviors>
    <b:Themed Surface="AppWindow" />
  </i:Interaction.Behaviors>

  <StackPanel Margin="16">
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="12" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <TextBlock
        Grid.Row="0"
        Grid.Column="0"
        Grid.ColumnSpan="3"
        Margin="0 0 0 4"
        Foreground="{DynamicResource SearchResultFileName}"
        Text="Filename:" />
      <TextBox
        x:Name="FilenameBox"
        Grid.Row="0"
        Grid.Column="0"
        Grid.ColumnSpan="3"
        Height="28"
        Margin="0 0 0 8"
        VerticalContentAlignment="Center"
        TextChanged="OnFieldTextChanged" />

      <TextBlock
        Grid.Row="1"
        Grid.Column="0"
        Grid.ColumnSpan="3"
        Margin="0 0 0 4"
        Foreground="{DynamicResource SearchResultFileName}"
        Text="Path contains:" />
      <TextBox
        x:Name="PathBox"
        Grid.Row="1"
        Grid.Column="0"
        Grid.ColumnSpan="3"
        Height="28"
        Margin="0 0 0 8"
        VerticalContentAlignment="Center"
        TextChanged="OnFieldTextChanged" />

      <StackPanel
        Grid.Row="2"
        Grid.Column="0"
        Margin="0 0 0 8">
        <TextBlock
          Margin="0 0 0 4"
          Foreground="{DynamicResource SearchResultFileName}"
          Text="Extension (no dot):" />
        <TextBox
          x:Name="ExtensionBox"
          Height="28"
          VerticalContentAlignment="Center"
          TextChanged="OnFieldTextChanged" />
      </StackPanel>
      <StackPanel
        Grid.Row="2"
        Grid.Column="2"
        Margin="0 0 0 8">
        <TextBlock
          Margin="0 0 0 4"
          Foreground="{DynamicResource SearchResultFileName}"
          Text="Attributes:" />
        <TextBox
          x:Name="AttributesBox"
          Height="28"
          VerticalContentAlignment="Center"
          TextChanged="OnFieldTextChanged" />
      </StackPanel>

      <StackPanel
        Grid.Row="3"
        Grid.Column="0"
        Margin="0 0 0 8">
        <TextBlock
          Margin="0 0 0 4"
          Foreground="{DynamicResource SearchResultFileName}"
          Text="Size min (bytes):" />
        <TextBox
          x:Name="SizeMinBox"
          Height="28"
          VerticalContentAlignment="Center"
          TextChanged="OnFieldTextChanged" />
      </StackPanel>
      <StackPanel
        Grid.Row="3"
        Grid.Column="2"
        Margin="0 0 0 8">
        <TextBlock
          Margin="0 0 0 4"
          Foreground="{DynamicResource SearchResultFileName}"
          Text="Size max (bytes):" />
        <TextBox
          x:Name="SizeMaxBox"
          Height="28"
          VerticalContentAlignment="Center"
          TextChanged="OnFieldTextChanged" />
      </StackPanel>

      <StackPanel
        Grid.Row="4"
        Grid.Column="0"
        Margin="0 0 0 8">
        <TextBlock
          Margin="0 0 0 4"
          Foreground="{DynamicResource SearchResultFileName}"
          Text="Date modified from:" />
        <DatePicker x:Name="DateModifiedFromPicker" SelectedDateChanged="OnFieldDateChanged" />
      </StackPanel>
      <StackPanel
        Grid.Row="4"
        Grid.Column="2"
        Margin="0 0 0 8">
        <TextBlock
          Margin="0 0 0 4"
          Foreground="{DynamicResource SearchResultFileName}"
          Text="Date modified to:" />
        <DatePicker x:Name="DateModifiedToPicker" SelectedDateChanged="OnFieldDateChanged" />
      </StackPanel>

      <StackPanel Grid.Row="5" Grid.Column="0">
        <TextBlock
          Margin="0 0 0 4"
          Foreground="{DynamicResource SearchResultFileName}"
          Text="Date created from:" />
        <DatePicker x:Name="DateCreatedFromPicker" SelectedDateChanged="OnFieldDateChanged" />
      </StackPanel>
      <StackPanel Grid.Row="5" Grid.Column="2">
        <TextBlock
          Margin="0 0 0 4"
          Foreground="{DynamicResource SearchResultFileName}"
          Text="Date created to:" />
        <DatePicker x:Name="DateCreatedToPicker" SelectedDateChanged="OnFieldDateChanged" />
      </StackPanel>
    </Grid>

    <StackPanel
      Margin="0 16 0 0"
      HorizontalAlignment="Right"
      Orientation="Horizontal">
      <Button
        x:Name="SearchButton"
        Width="80"
        Height="26"
        Click="OnSearchClick"
        Content="Search"
        IsDefault="True"
        IsEnabled="False" />
      <Button
        Width="80"
        Height="26"
        Margin="8 0 0 0"
        Click="OnClearClick"
        Content="Clear" />
      <Button
        Width="80"
        Height="26"
        Margin="8 0 0 0"
        Content="Cancel"
        IsCancel="True" />
    </StackPanel>
  </StackPanel>
</Window>
