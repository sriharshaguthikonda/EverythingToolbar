<Window
  x:Class="EverythingToolbar.ExpandedSearchWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:appsearch="clr-namespace:EverythingToolbar.App.Search;assembly=EverythingToolbar.App"
  xmlns:b="clr-namespace:EverythingToolbar.Behaviors"
  xmlns:c="clr-namespace:EverythingToolbar.Converters"
  xmlns:controls="clr-namespace:EverythingToolbar.Controls"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
  xmlns:markup="clr-namespace:EverythingToolbar.Markup"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  Title="EverythingToolbar Search"
  Width="1100"
  Height="700"
  MinWidth="900"
  MinHeight="600"
  d:DesignHeight="600"
  d:DesignWidth="900"
  Background="{DynamicResource ApplicationBackgroundBrush}"
  PreviewKeyDown="OnPreviewKeyDown"
  ShowInTaskbar="True"
  UseLayoutRounding="True"
  WindowStartupLocation="CenterScreen"
  mc:Ignorable="d">
  <i:Interaction.Behaviors>
    <b:Themed Surface="AppWindow" />
  </i:Interaction.Behaviors>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Menu
      Grid.Row="0"
      Background="{DynamicResource SearchWindowBackground}"
      Foreground="{DynamicResource SearchResultFileName}">
      <MenuItem Header="File">
        <MenuItem
          Click="OnNewTabClick"
          Header="New Tab"
          InputGestureText="Ctrl+T" />
        <MenuItem
          Click="OnCloseTabClick"
          Header="Close Tab"
          InputGestureText="Ctrl+W" />
        <Separator />
        <MenuItem
          Click="OnNewWindowClick"
          Header="New Window"
          InputGestureText="Ctrl+Shift+E" />
        <Separator />
        <MenuItem
          x:Name="SessionsMenu"
          Header="Sessions"
          SubmenuOpened="OnSessionsSubmenuOpened">
          <MenuItem Click="OnSaveSessionClick" Header="Save Session…" />
          <Separator />
          <MenuItem Header="(no sessions)" IsEnabled="False" />
        </MenuItem>
        <Separator />
        <MenuItem
          x:Name="ExportMenuItem"
          Click="OnExportClick"
          Header="Export…"
          InputGestureText="Ctrl+S" />
        <Separator />
        <MenuItem
          Click="OnCloseClick"
          Header="Close"
          InputGestureText="Alt+F4" />
      </MenuItem>
      <MenuItem
        x:Name="EditMenu"
        Header="Edit"
        SubmenuOpened="OnEditSubmenuOpened">
        <MenuItem
          x:Name="EditCutMenuItem"
          Click="OnEditCutClick"
          Header="Cut"
          InputGestureText="Ctrl+X" />
        <MenuItem
          x:Name="EditCopyNameMenuItem"
          Click="OnEditCopyNameClick"
          Header="Copy Name"
          InputGestureText="Ctrl+Shift+N" />
        <MenuItem
          x:Name="EditCopyPathMenuItem"
          Click="OnEditCopyPathClick"
          Header="Copy Path"
          InputGestureText="Ctrl+Shift+P" />
        <MenuItem
          x:Name="EditCopyMenuItem"
          Click="OnEditCopyClick"
          Header="Copy"
          InputGestureText="Ctrl+C" />
        <MenuItem
          x:Name="EditPasteMenuItem"
          Click="OnEditPasteClick"
          Header="Paste"
          InputGestureText="Ctrl+V" />
        <Separator />
        <MenuItem
          x:Name="EditDeleteMenuItem"
          Click="OnEditDeleteClick"
          Header="Delete"
          InputGestureText="Del" />
      </MenuItem>
      <MenuItem Header="View">
        <MenuItem
          x:Name="SortByMenu"
          Header="Sort By"
          SubmenuOpened="OnSortBySubmenuOpened">
          <MenuItem Header="(no sort items)" IsEnabled="False" />
        </MenuItem>
        <Separator />
        <MenuItem
          x:Name="FolderSidebarMenuItem"
          Click="OnToggleFolderSidebarClick"
          Header="Toggle Folder Sidebar"
          InputGestureText="Ctrl+B"
          IsCheckable="True" />
        <MenuItem
          x:Name="BookmarkBarMenuItem"
          Click="OnToggleBookmarkBarClick"
          Header="Bookmark Bar"
          IsCheckable="True" />
        <MenuItem
          Click="OnTogglePreviewClick"
          Header="Toggle Preview"
          InputGestureText="Ctrl+P" />
        <MenuItem Click="OnToggleStatusBarClick" Header="Toggle Status Bar" />
        <Separator />
        <MenuItem
          x:Name="DetailsViewMenuItem"
          Click="OnDetailsViewClick"
          Header="Details"
          IsCheckable="True" />
        <MenuItem
          x:Name="ThumbnailsViewMenuItem"
          Click="OnThumbnailsViewClick"
          Header="Thumbnails"
          IsCheckable="True" />
      </MenuItem>
      <MenuItem Header="Search">
        <MenuItem
          Click="OnToggleMatchCaseClick"
          Header="Match Case"
          InputGestureText="Ctrl+I"
          IsCheckable="True"
          IsChecked="{Binding Source={markup:Service {x:Type appsearch:SearchState}}, Path=IsMatchCase, Mode=OneWay}" />
        <MenuItem
          Click="OnToggleMatchWholeWordClick"
          Header="Match Whole Word"
          InputGestureText="Ctrl+Shift+W"
          IsCheckable="True"
          IsChecked="{Binding Source={markup:Service {x:Type appsearch:SearchState}}, Path=IsMatchWholeWord, Mode=OneWay}" />
        <MenuItem
          Click="OnToggleMatchPathClick"
          Header="Match Path"
          InputGestureText="Ctrl+Shift+U"
          IsCheckable="True"
          IsChecked="{Binding Source={markup:Service {x:Type appsearch:SearchState}}, Path=IsMatchPath, Mode=OneWay}" />
        <MenuItem
          Click="OnToggleRegexClick"
          Header="Regex"
          InputGestureText="Ctrl+Shift+R"
          IsCheckable="True"
          IsChecked="{Binding Source={markup:Service {x:Type appsearch:SearchState}}, Path=IsRegExEnabled, Mode=OneWay}" />
        <Separator />
        <MenuItem
          Click="OnAdvancedSearchClick"
          Header="Advanced Search…"
          InputGestureText="Ctrl+Shift+A" />
      </MenuItem>
      <MenuItem
        x:Name="ToolsMenu"
        Header="Tools"
        SubmenuOpened="OnToolsSubmenuOpened">
        <MenuItem Click="OnEverythingClick" Header="Everything" />
        <!--
          Two rename entry points by design: "Batch Rename…" uses the in-app
          BatchRenameEngine + shell IFileOperation (works without Everything running);
          "Advanced Rename…" delegates to Everything's native -rename dialog.
        -->
        <MenuItem
          x:Name="ToolsBatchRenameMenuItem"
          Click="OnBatchRenameClick"
          Header="Batch Rename…" />
        <MenuItem
          x:Name="ToolsAdvancedRenameMenuItem"
          Click="OnAdvancedRenameClick"
          Header="Advanced Rename…" />
        <MenuItem Click="OnFindDuplicateNamesClick" Header="Find Duplicate Names" />
      </MenuItem>
      <MenuItem
        x:Name="BookmarksMenu"
        Header="Bookmarks"
        SubmenuOpened="OnBookmarksSubmenuOpened">
        <MenuItem
          Click="OnAddBookmarkClick"
          Header="Add Bookmark…"
          InputGestureText="Ctrl+D" />
        <Separator />
        <MenuItem Header="(no bookmarks)" IsEnabled="False" />
      </MenuItem>
      <MenuItem Header="Help">
        <MenuItem Click="OnAboutClick" Header="About" />
      </MenuItem>
    </Menu>

    <Border
      x:Name="TabStrip"
      Grid.Row="1"
      Margin="8 4 8 0"
      Background="Transparent"
      Visibility="Collapsed">
      <Border.Style>
        <Style TargetType="Border">
          <Setter Property="Visibility" Value="Collapsed" />
          <Style.Triggers>
            <DataTrigger Binding="{Binding Source={markup:Service {x:Type appsearch:SearchTabManager}}, Path=IsTabStripVisible}" Value="True">
              <Setter Property="Visibility" Value="Visible" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </Border.Style>
      <ItemsControl
        x:Name="TabHeaders"
        Background="Transparent"
        ItemsSource="{Binding Source={markup:Service {x:Type appsearch:SearchTabManager}}, Path=Tabs}"
        MouseLeftButtonDown="OnTabStripMouseDown">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <StackPanel Orientation="Horizontal" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border
              x:Name="TabHeaderBorder"
              Margin="0 0 2 0"
              Padding="10 4 4 4"
              Background="Transparent"
              CornerRadius="4"
              Cursor="Hand"
              MouseLeftButtonDown="OnTabHeaderMouseDown"
              Tag="{Binding}">
              <Border.Style>
                <Style TargetType="Border">
                  <Setter Property="Background" Value="Transparent" />
                  <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                      <Setter Property="Background" Value="{DynamicResource TabBarButtonBackgroundHover}" />
                    </Trigger>
                    <DataTrigger Binding="{Binding IsActive}" Value="True">
                      <Setter Property="Background" Value="{DynamicResource TabBarButtonBackgroundActive}" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Border.Style>
              <StackPanel Orientation="Horizontal">
                <TextBlock
                  MaxWidth="160"
                  Margin="0 0 6 0"
                  VerticalAlignment="Center"
                  Foreground="{DynamicResource SearchResultFileName}"
                  Text="{Binding DisplayName}"
                  TextTrimming="CharacterEllipsis" />
                <Button
                  Click="OnTabCloseClick"
                  Content="&#xE711;"
                  FontFamily="Segoe MDL2 Assets"
                  FontSize="10"
                  Tag="{Binding}">
                  <Button.Style>
                    <Style TargetType="Button">
                      <Setter Property="Opacity" Value="0" />
                      <Setter Property="Background" Value="Transparent" />
                      <Setter Property="BorderThickness" Value="0" />
                      <Setter Property="Foreground" Value="{DynamicResource SearchResultFileName}" />
                      <Setter Property="VerticalAlignment" Value="Center" />
                      <Setter Property="Padding" Value="4 2 4 2" />
                      <Setter Property="Cursor" Value="Hand" />
                      <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                          <Setter Property="Opacity" Value="1" />
                        </Trigger>
                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                          <Setter Property="Opacity" Value="0.7" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </Button.Style>
                </Button>
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </Border>

    <!--
      Bookmark bar (Everything-1.5 parity): a quick-access row of buttons, one per bookmark in
      the store's alphabetical order, bound live to SearchBookmarkStore.Bookmarks. Overflow wraps
      into additional lines (bookmark counts are small; no virtualization needed). The row hides
      itself when the setting is off OR no bookmarks exist (BookmarkBarInfo.IsBarVisible).
    -->
    <Border
      x:Name="BookmarkBar"
      Grid.Row="2"
      Margin="8 4 8 0"
      Padding="6 4 2 2"
      Background="{DynamicResource SearchWindowBackground}"
      BorderBrush="{DynamicResource TabBarBottomBorder}"
      BorderThickness="0 0 0 1"
      Visibility="Collapsed">
      <ItemsControl x:Name="BookmarkBarItems" ItemsSource="{Binding Source={markup:Service {x:Type appsearch:SearchBookmarkStore}}, Path=Bookmarks}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <WrapPanel Orientation="Horizontal" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Button
              Click="OnBookmarkBarButtonClick"
              Content="{Binding Name}"
              ToolTipOpening="OnBookmarkBarButtonToolTipOpening">
              <Button.ContextMenu>
                <ContextMenu>
                  <MenuItem Click="OnBookmarkBarRemoveClick" Header="Remove Bookmark" />
                  <MenuItem Click="OnBookmarkBarRenameClick" Header="Rename Bookmark…" />
                </ContextMenu>
              </Button.ContextMenu>
              <Button.Style>
                <Style TargetType="Button">
                  <Setter Property="Background" Value="Transparent" />
                  <Setter Property="BorderThickness" Value="0" />
                  <Setter Property="Foreground" Value="{DynamicResource SearchResultFileName}" />
                  <Setter Property="Margin" Value="0 0 4 2" />
                  <Setter Property="Padding" Value="8 3 8 3" />
                  <Setter Property="Cursor" Value="Hand" />
                  <Setter Property="HorizontalContentAlignment" Value="Left" />
                  <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                      <Setter Property="Background" Value="{DynamicResource TabBarButtonBackgroundHover}" />
                    </Trigger>
                  </Style.Triggers>
                </Style>
              </Button.Style>
            </Button>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </Border>

    <Grid Grid.Row="3" Margin="8 8 8 0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <controls:SearchBox
        x:Name="SearchBox"
        Grid.Column="0"
        Height="40"
        VerticalAlignment="Top"
        SearchTerm="{Binding Source={markup:Service {x:Type appsearch:SearchState}}, Path=SearchTerm, Mode=TwoWay}" />
      <controls:FilterSelector
        x:Name="FilterSelector"
        Grid.Column="1"
        Margin="8 0 0 0"
        VerticalAlignment="Center"
        SelectedFilter="{Binding Source={markup:Service {x:Type appsearch:SearchState}}, Path=Filter, Mode=TwoWay}" />
    </Grid>

    <Grid Grid.Row="4" Margin="8 8 8 0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition x:Name="SidebarColumn" Width="240" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <controls:FolderSidebarView
        x:Name="FolderSidebar"
        Grid.Column="0"
        Visibility="Collapsed" />
      <controls:SearchResultsDataView x:Name="ResultsView" Grid.Column="1" />
      <controls:SearchResultPreviewPane
        x:Name="PreviewPane"
        Grid.Column="2"
        Width="380"
        Margin="8 0 0 0"
        SelectedResult="{Binding ElementName=ResultsView, Path=SelectedResult}" />
    </Grid>

    <Border
      x:Name="StatusBar"
      Grid.Row="5"
      Padding="8 4 8 4"
      Background="{DynamicResource SearchWindowBackground}"
      BorderBrush="{DynamicResource TabBarBottomBorder}"
      BorderThickness="0 1 0 0">
      <Grid>
        <StackPanel HorizontalAlignment="Left" Orientation="Horizontal">
          <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource SearchResultPath}">
            <Run Text="{Binding Source={markup:Service {x:Type appsearch:SearchSession}}, Path=StatusCountText, Mode=OneWay}" />
          </TextBlock>
          <TextBlock
            VerticalAlignment="Center"
            Foreground="{DynamicResource SearchResultPath}"
            Text="Searching…">
            <TextBlock.Style>
              <Style TargetType="TextBlock">
                <Setter Property="Visibility" Value="Collapsed" />
                <Setter Property="Margin" Value="8 0 0 0" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding Source={markup:Service {x:Type appsearch:SearchSession}}, Path=IsBusy}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
          <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource SearchResultPath}">
            <TextBlock.Style>
              <Style TargetType="TextBlock">
                <Setter Property="Visibility" Value="Visible" />
                <Setter Property="Margin" Value="8 0 0 0" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding Source={markup:Service {x:Type appsearch:SearchSession}}, Path=FallbackHint}" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Collapsed" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
            <Run Text="{Binding Source={markup:Service {x:Type appsearch:SearchSession}}, Path=FallbackHint, Mode=OneWay}" />
          </TextBlock>
          <TextBlock
            x:Name="ExportStatusText"
            VerticalAlignment="Center"
            Foreground="{DynamicResource SearchResultPath}">
            <TextBlock.Style>
              <Style TargetType="TextBlock">
                <Setter Property="Visibility" Value="Collapsed" />
                <Setter Property="Margin" Value="8 0 0 0" />
                <Style.Triggers>
                  <Trigger Property="Text" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Collapsed" />
                  </Trigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
        </StackPanel>
        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
          <StackPanel.Resources>
            <Style x:Key="ChipStyle" TargetType="TextBlock">
              <Setter Property="Margin" Value="6 0 0 0" />
              <Setter Property="Opacity" Value="0.4" />
              <Setter Property="Foreground" Value="{DynamicResource SearchResultPath}" />
              <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter Property="Opacity" Value="0.8" />
                </Trigger>
              </Style.Triggers>
            </Style>
          </StackPanel.Resources>
          <TextBlock
            MouseLeftButtonDown="OnChipClick"
            Tag="Case"
            Text="CASE">
            <TextBlock.Style>
              <Style BasedOn="{StaticResource ChipStyle}" TargetType="TextBlock">
                <Style.Triggers>
                  <DataTrigger Binding="{Binding Source={markup:Service {x:Type appsearch:SearchState}}, Path=IsMatchCase}" Value="True">
                    <Setter Property="Opacity" Value="1" />
                    <Setter Property="FontWeight" Value="Bold" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
          <TextBlock
            MouseLeftButtonDown="OnChipClick"
            Tag="Word"
            Text="WORD">
            <TextBlock.Style>
              <Style BasedOn="{StaticResource ChipStyle}" TargetType="TextBlock">
                <Style.Triggers>
                  <DataTrigger Binding="{Binding Source={markup:Service {x:Type appsearch:SearchState}}, Path=IsMatchWholeWord}" Value="True">
                    <Setter Property="Opacity" Value="1" />
                    <Setter Property="FontWeight" Value="Bold" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
          <TextBlock
            MouseLeftButtonDown="OnChipClick"
            Tag="Path"
            Text="PATH">
            <TextBlock.Style>
              <Style BasedOn="{StaticResource ChipStyle}" TargetType="TextBlock">
                <Style.Triggers>
                  <DataTrigger Binding="{Binding Source={markup:Service {x:Type appsearch:SearchState}}, Path=IsMatchPath}" Value="True">
                    <Setter Property="Opacity" Value="1" />
                    <Setter Property="FontWeight" Value="Bold" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
          <TextBlock
            MouseLeftButtonDown="OnChipClick"
            Tag="Regex"
            Text="REGEX">
            <TextBlock.Style>
              <Style BasedOn="{StaticResource ChipStyle}" TargetType="TextBlock">
                <Style.Triggers>
                  <DataTrigger Binding="{Binding Source={markup:Service {x:Type appsearch:SearchState}}, Path=IsRegExEnabled}" Value="True">
                    <Setter Property="Opacity" Value="1" />
                    <Setter Property="FontWeight" Value="Bold" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</Window>
