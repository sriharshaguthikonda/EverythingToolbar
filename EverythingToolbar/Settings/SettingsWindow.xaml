<ui:FluentWindow
  x:Class="EverythingToolbar.Settings.SettingsWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:behaviors="clr-namespace:EverythingToolbar.Behaviors"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:properties="clr-namespace:EverythingToolbar.Properties"
  xmlns:settings="clr-namespace:EverythingToolbar.Settings"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
  Title="{x:Static properties:Resources.SettingsPreferences}"
  Width="1100"
  Height="620"
  Background="{DynamicResource ApplicationBackgroundBrush}"
  ExtendsContentIntoTitleBar="True"
  Foreground="{DynamicResource TextFillColorPrimaryBrush}"
  WindowBackdropType="Mica"
  WindowCornerPreference="Round"
  WindowStartupLocation="CenterScreen"
  mc:Ignorable="d">
  <i:Interaction.Behaviors>
    <behaviors:Themed Surface="AppWindow" />
  </i:Interaction.Behaviors>

  <Window.Resources>
    <Style x:Key="SettingsSearchResultItemStyle" TargetType="ListBoxItem">
      <Setter Property="Padding" Value="4" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
  </Window.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <ui:TitleBar
      Title="EverythingToolbar"
      Grid.Row="0"
      CloseWindowByDoubleClickOnIcon="True">
      <ui:TitleBar.Icon>
        <ui:ImageIcon Source="pack://application:,,,/EverythingToolbar;component/Images/AppIcon.ico" />
      </ui:TitleBar.Icon>
    </ui:TitleBar>

    <Grid Grid.Row="1" Margin="40 8 40 4">
      <ui:TextBox
        x:Name="SettingsSearchBox"
        AutomationProperties.HelpText="{x:Static properties:Resources.SettingsSearchSettingsHelp}"
        AutomationProperties.Name="{x:Static properties:Resources.SettingsSearchSettings}"
        PlaceholderText="{x:Static properties:Resources.SettingsSearchSettings}"
        PreviewKeyDown="OnSettingsSearchBoxKeyDown"
        TextChanged="OnSettingsSearchTextChanged" />
      <Popup
        x:Name="SearchResultsPopup"
        AllowsTransparency="True"
        Placement="Bottom"
        PlacementTarget="{Binding ElementName=SettingsSearchBox}"
        PopupAnimation="Fade"
        StaysOpen="False">
        <Border
          Margin="0 2 0 0"
          Padding="4"
          Background="{DynamicResource ApplicationBackgroundBrush}"
          BorderBrush="{DynamicResource TextFillColorSecondaryBrush}"
          BorderThickness="1"
          CornerRadius="8">
          <ListBox
            x:Name="SearchResultsList"
            MinWidth="420"
            MaxHeight="320"
            Background="Transparent"
            BorderThickness="0"
            ItemContainerStyle="{StaticResource SettingsSearchResultItemStyle}"
            KeyDown="OnSearchResultKeyDown"
            PreviewMouseLeftButtonDown="OnSearchResultClick">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <StackPanel MinWidth="380" Margin="6 4">
                  <TextBlock
                    AutomationProperties.Name="{Binding Title}"
                    FontSize="14"
                    FontWeight="SemiBold"
                    Text="{Binding Title}" />
                  <TextBlock
                    FontSize="12"
                    Opacity="0.7"
                    Text="{Binding PageName}" />
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Border>
      </Popup>
    </Grid>

    <ui:NavigationView
      Name="ThisNavigationView"
      Grid.Row="2"
      MinHeight="300"
      IsBackButtonVisible="Collapsed"
      IsPaneToggleVisible="True"
      PaneTitle="{x:Static properties:Resources.SettingsPreferences}">
      <ui:NavigationView.MenuItems>
        <ui:NavigationViewItem
          Content="{x:Static properties:Resources.SettingsHome}"
          Icon="{ui:SymbolIcon Home24}"
          TargetPageType="{x:Type settings:About}" />
        <ui:NavigationViewItem
          Content="{x:Static properties:Resources.SettingsSearch}"
          Icon="{ui:SymbolIcon SearchSettings20}"
          TargetPageType="{x:Type settings:Search}" />
        <ui:NavigationViewItem
          Content="{x:Static properties:Resources.SettingsUserInterface}"
          Icon="{ui:SymbolIcon WindowSettings20}"
          TargetPageType="{x:Type settings:UserInterface}" />
        <ui:NavigationViewItem
          Content="{x:Static properties:Resources.SettingsFilters}"
          Icon="{ui:SymbolIcon DataFunnel24}"
          TargetPageType="{x:Type settings:Filters}" />
        <ui:NavigationViewItem
          Content="{x:Static properties:Resources.SettingsCustomActions}"
          Icon="{ui:SymbolIcon Open24}"
          TargetPageType="{x:Type settings:CustomActions}" />
        <ui:NavigationViewItem
          Content="{x:Static properties:Resources.SettingsShortcuts}"
          Icon="{ui:SymbolIcon Keyboard24}"
          TargetPageType="{x:Type settings:Shortcuts}" />
        <ui:NavigationViewItem
          Content="{x:Static properties:Resources.SettingsAdvanced}"
          Icon="{ui:SymbolIcon Warning24}"
          TargetPageType="{x:Type settings:Advanced}" />
      </ui:NavigationView.MenuItems>
      <ui:NavigationView.FooterMenuItems>
        <ui:NavigationViewItem
          Click="OnReportABugClicked"
          Content="{x:Static properties:Resources.SettingsReportProblem}"
          Icon="{ui:SymbolIcon Bug24}" />
      </ui:NavigationView.FooterMenuItems>
    </ui:NavigationView>
  </Grid>
</ui:FluentWindow>
