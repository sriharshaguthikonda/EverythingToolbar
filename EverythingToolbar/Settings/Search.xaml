<Page
  x:Class="EverythingToolbar.Settings.Search"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:b="clr-namespace:EverythingToolbar.Behaviors"
  xmlns:c="clr-namespace:EverythingToolbar.Converters"
  xmlns:controls="clr-namespace:EverythingToolbar.Controls"
  xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
  xmlns:properties="clr-namespace:EverythingToolbar.Properties"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
  Foreground="{DynamicResource TextFillColorPrimaryBrush}"
  ScrollViewer.CanContentScroll="False"
  Unloaded="OnUnloaded">
  <i:Interaction.Behaviors>
    <b:Themed Surface="AppWindow" />
  </i:Interaction.Behaviors>

  <ScrollViewer>
    <StackPanel Margin="40">
      <ui:TextBlock
        Margin="0 0 0 25"
        FontTypography="Title"
        Text="{x:Static properties:Resources.SettingsSearch}" />
      <ui:TextBlock
        Margin="0 0 0 7"
        FontTypography="BodyStrong"
        Text="{x:Static properties:Resources.SettingsBehavior}" />
      <Border
        Padding="16"
        Background="{ui:ThemeResource CardBackgroundFillColorDefaultBrush}"
        BorderBrush="{ui:ThemeResource CardStrokeColorDefaultBrush}"
        BorderThickness="1 1 1 0"
        CornerRadius="8,8,0,0">
        <controls:SettingItem Title="{x:Static properties:Resources.SettingsHideEmptyResults}" HelpText="{x:Static properties:Resources.SettingsHideEmptyResultsHelp}">
          <controls:SettingItem.SettingContent>
            <ui:ToggleSwitch IsChecked="{Binding Settings.IsHideEmptySearchResults, Mode=TwoWay}" />
          </controls:SettingItem.SettingContent>
        </controls:SettingItem>
      </Border>
      <Border
        Padding="16"
        Background="{ui:ThemeResource CardBackgroundFillColorDefaultBrush}"
        BorderBrush="{ui:ThemeResource CardStrokeColorDefaultBrush}"
        BorderThickness="1 1 1 0"
        CornerRadius="0">
        <controls:SettingItem Title="{x:Static properties:Resources.SettingsSearchAsYouType}" HelpText="{x:Static properties:Resources.SettingsSearchAsYouTypeHelp}">
          <controls:SettingItem.SettingContent>
            <ui:ToggleSwitch IsChecked="{Binding Settings.IsSearchAsYouType, Mode=TwoWay}" />
          </controls:SettingItem.SettingContent>
        </controls:SettingItem>
      </Border>
      <Border
        Padding="16"
        Background="{ui:ThemeResource CardBackgroundFillColorDefaultBrush}"
        BorderBrush="{ui:ThemeResource CardStrokeColorDefaultBrush}"
        BorderThickness="1 1 1 0"
        CornerRadius="0">
        <StackPanel>
          <controls:SettingItem Title="{x:Static properties:Resources.SettingsTypoTolerantSearch}" HelpText="{x:Static properties:Resources.SettingsTypoTolerantSearchHelp}">
            <controls:SettingItem.SettingContent>
              <ui:ToggleSwitch IsChecked="{Binding Settings.IsTypoTolerantSearchEnabled, Mode=TwoWay}" />
            </controls:SettingItem.SettingContent>
          </controls:SettingItem>
          <TextBlock
            Margin="0 8 0 0"
            FontSize="12"
            Opacity="0.8"
            Text="{Binding VocabularyStatusText}" />
          <Button
            Margin="0 8 0 0"
            HorizontalAlignment="Left"
            Click="OnRefreshVocabularyClicked"
            Content="{x:Static properties:Resources.SettingsVocabRefreshNow}" />
          <ui:TextBlock
            Margin="0 16 0 4"
            FontTypography="BodyStrong"
            Text="{x:Static properties:Resources.SettingsTypoAdvancedHeader}" />
          <controls:SettingItem Title="{x:Static properties:Resources.SettingsTypoMaxIndexDistance}" HelpText="{x:Static properties:Resources.SettingsTypoMaxIndexDistanceHelp}">
            <controls:SettingItem.SettingContent>
              <ComboBox MinWidth="64" ItemsSource="{Binding DistanceItems}" SelectedValue="{Binding Settings.TypoMaxDictionaryEditDistance, Mode=TwoWay}" />
            </controls:SettingItem.SettingContent>
          </controls:SettingItem>
          <controls:SettingItem Title="{x:Static properties:Resources.SettingsTypoLongWordDistance}" HelpText="{x:Static properties:Resources.SettingsTypoLongWordDistanceHelp}">
            <controls:SettingItem.SettingContent>
              <ComboBox MinWidth="64" ItemsSource="{Binding DistanceItems}" SelectedValue="{Binding Settings.TypoLongWordMaxEditDistance, Mode=TwoWay}" />
            </controls:SettingItem.SettingContent>
          </controls:SettingItem>
          <controls:SettingItem Title="{x:Static properties:Resources.SettingsTypoLongWordThreshold}" HelpText="{x:Static properties:Resources.SettingsTypoLongWordThresholdHelp}">
            <controls:SettingItem.SettingContent>
              <StackPanel Orientation="Horizontal">
                <ComboBox MinWidth="64" ItemsSource="{Binding LongWordThresholdItems}" SelectedValue="{Binding Settings.TypoLongWordMinLength, Mode=TwoWay}" />
                <TextBlock Margin="8 0 0 0" VerticalAlignment="Center" Text="{x:Static properties:Resources.SettingsTypoLongWordThresholdUnit}" />
              </StackPanel>
            </controls:SettingItem.SettingContent>
          </controls:SettingItem>
          <Button
            Margin="0 8 0 0"
            HorizontalAlignment="Left"
            Click="OnRebuildSpellingIndexClicked"
            Content="{x:Static properties:Resources.SettingsTypoRebuildIndex}" />
        </StackPanel>
      </Border>
      <Border
        Padding="16"
        Background="{ui:ThemeResource CardBackgroundFillColorDefaultBrush}"
        BorderBrush="{ui:ThemeResource CardStrokeColorDefaultBrush}"
        BorderThickness="1 1 1 0"
        CornerRadius="0">
        <StackPanel>
          <controls:SettingItem Title="{x:Static properties:Resources.SettingsPreferredSpellings}" HelpText="{x:Static properties:Resources.SettingsPreferredSpellingsHelp}">
            <controls:SettingItem.SettingContent>
              <Button Click="OnSaveAliasesClicked" Content="{x:Static properties:Resources.SettingsSave}" />
            </controls:SettingItem.SettingContent>
          </controls:SettingItem>
          <ui:TextBox
            x:Name="AliasesTextBox"
            MinHeight="96"
            AcceptsReturn="True"
            PlaceholderText="{x:Static properties:Resources.SettingsPreferredSpellingsHelp}"
            TextWrapping="NoWrap"
            VerticalScrollBarVisibility="Auto" />
        </StackPanel>
      </Border>
      <Border
        Padding="16"
        Background="{ui:ThemeResource CardBackgroundFillColorDefaultBrush}"
        BorderBrush="{ui:ThemeResource CardStrokeColorDefaultBrush}"
        BorderThickness="1 1 1 0"
        CornerRadius="0">
        <controls:SettingItem Title="{x:Static properties:Resources.SettingsSelectFirstResult}" HelpText="{x:Static properties:Resources.SettingsSelectFirstResultHelp}">
          <controls:SettingItem.SettingContent>
            <ui:ToggleSwitch IsChecked="{Binding Settings.IsAutoSelectFirstResult, Mode=TwoWay}" />
          </controls:SettingItem.SettingContent>
        </controls:SettingItem>
      </Border>
      <Border
        Padding="16"
        Background="{ui:ThemeResource CardBackgroundFillColorDefaultBrush}"
        BorderBrush="{ui:ThemeResource CardStrokeColorDefaultBrush}"
        BorderThickness="1 1 1 0"
        CornerRadius="0">
        <controls:SettingItem Title="{x:Static properties:Resources.SettingsHomeEndNavigateResults}" HelpText="{x:Static properties:Resources.SettingsHomeEndNavigateResultsHelp}">
          <controls:SettingItem.SettingContent>
            <ui:ToggleSwitch IsChecked="{Binding Settings.IsHomeEndNavigateResults, Mode=TwoWay}" />
          </controls:SettingItem.SettingContent>
        </controls:SettingItem>
      </Border>
      <Border
        Padding="16"
        Background="{ui:ThemeResource CardBackgroundFillColorDefaultBrush}"
        BorderBrush="{ui:ThemeResource CardStrokeColorDefaultBrush}"
        BorderThickness="1 1 1 0"
        CornerRadius="0">
        <controls:SettingItem Title="{x:Static properties:Resources.SettingsListFocusBehavior}" HelpText="{x:Static properties:Resources.SettingsListFocusBehaviorHelp}">
          <controls:SettingItem.SettingContent>
            <ComboBox
              HorizontalAlignment="Right"
              DisplayMemberPath="Key"
              ItemsSource="{Binding FocusBehaviorItems}"
              SelectedValue="{Binding Settings.ListFocusBehavior, Mode=TwoWay}"
              SelectedValuePath="Value" />
          </controls:SettingItem.SettingContent>
        </controls:SettingItem>
      </Border>
      <Border
        Padding="16"
        Background="{ui:ThemeResource CardBackgroundFillColorDefaultBrush}"
        BorderBrush="{ui:ThemeResource CardStrokeColorDefaultBrush}"
        BorderThickness="1 1 1 1"
        CornerRadius="0, 0, 8, 8">
        <controls:SettingItem Title="{x:Static properties:Resources.SettingsDoubleClickToOpen}" HelpText="{x:Static properties:Resources.SettingsDoubleClickHelp}">
          <controls:SettingItem.SettingContent>
            <ui:ToggleSwitch IsChecked="{Binding Settings.IsDoubleClickToOpen, Mode=TwoWay}" />
          </controls:SettingItem.SettingContent>
        </controls:SettingItem>
      </Border>

      <StackPanel Visibility="{Binding IsResultOmissionsSupported, Converter={c:BoolToVisibilityConverter}}">
        <ui:TextBlock
          Margin="0 25 0 7"
          FontTypography="BodyStrong"
          Text="{x:Static properties:Resources.SettingsResults}" />
        <Border
          Padding="16"
          Background="{ui:ThemeResource CardBackgroundFillColorDefaultBrush}"
          BorderBrush="{ui:ThemeResource CardStrokeColorDefaultBrush}"
          BorderThickness="1 1 1 1"
          CornerRadius="8, 8, 8, 8">
          <controls:SettingItem Title="{x:Static properties:Resources.SettingsEnableResultOmissions}" HelpText="{x:Static properties:Resources.SettingsEnableResultOmissionsHelp}">
            <controls:SettingItem.SettingContent>
              <ui:ToggleSwitch IsChecked="{Binding Settings.IsHideResultOmissions, Mode=TwoWay}" />
            </controls:SettingItem.SettingContent>
          </controls:SettingItem>
        </Border>
      </StackPanel>

      <ui:TextBlock
        Margin="0 25 0 7"
        FontTypography="BodyStrong"
        Text="{x:Static properties:Resources.SettingsHistory}" />
      <Border
        Padding="16"
        Background="{ui:ThemeResource CardBackgroundFillColorDefaultBrush}"
        BorderBrush="{ui:ThemeResource CardStrokeColorDefaultBrush}"
        BorderThickness="1 1 1 1"
        CornerRadius="8, 8, 8, 8">
        <controls:SettingItem Title="{x:Static properties:Resources.SettingsEnableHistory}" HelpText="{x:Static properties:Resources.SettingsHistoryHelp}">
          <controls:SettingItem.SettingContent>
            <StackPanel Orientation="Horizontal">
              <ui:Button
                HorizontalAlignment="Right"
                Click="OnClearHistoryClicked"
                Content="{x:Static properties:Resources.SettingsClearHistoryNow}" />
              <ui:ToggleSwitch Margin="15 0 0 0" IsChecked="{Binding Settings.IsEnableHistory, Mode=TwoWay}" />
            </StackPanel>
          </controls:SettingItem.SettingContent>
        </controls:SettingItem>
      </Border>
    </StackPanel>
  </ScrollViewer>
</Page>
