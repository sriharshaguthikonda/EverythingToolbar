<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <RootNamespace>EverythingToolbar.Platform</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- UseWPF: the shell file-operations service uses System.Windows.Clipboard (CF_HDROP +
         Preferred DropEffect) for Explorer-parity Cut/Copy/Paste, and the edit gesture mapper
         classifies System.Windows.Input.Key gestures. -->
    <UseWPF>true</UseWPF>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference
      Include="..\EverythingSDK\EverythingSDK.vcxproj"
      Condition="'$(FuzzyManagedOnlyBuild)' != 'true'"
    />
    <ProjectReference
      Include="..\EverythingSDK3\EverythingSDK3.vcxproj"
      Condition="'$(FuzzyManagedOnlyBuild)' != 'true'"
    />
    <ProjectReference Include="..\EverythingToolbar.Core\EverythingToolbar.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="NLog" />
    <PackageReference Include="Microsoft.Windows.CsWin32">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <Using Include="EverythingToolbar.Core.Search" />
  </ItemGroup>
</Project>
